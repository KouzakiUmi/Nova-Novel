{
  "name": "nova-novel",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @nova-novel/shared --filter @nova-novel/server --filter @nova-novel/web dev",
    "build": "pnpm -r build",
    "start": "pnpm --filter @nova-novel/server start",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:runtime": "node scripts/test-packed-runtime.mjs",
    "dist:win": "node scripts/package-windows.mjs",
    "dist:win:dir": "node scripts/package-windows.mjs --dir"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "electron": "44.7.2",
    "electron-builder": "^26.18.0"
  }
}
